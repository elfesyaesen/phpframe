## No directory listings
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>
Options -Indexes

## Security headers
<IfModule mod_headers.c>
  Header set Referrer-Policy "no-referrer"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Permissions-Policy "interest-cohort=()"
</IfModule>

RewriteEngine On

# Forward Authorization header (FastCGI/PHP-FPM bazi setup'larda dusurulur)
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

# Var olan dosya/dizin ve statik asset uzantilari icin rewrite yok;
# diger her sey index.php'ye gider.
#
# ISTISNA: /media/p/... ve /media/s/... adresleri .webp/.avif/.pdf ile biter
# ama diskte DEGIL, PHP tarafindan sunulur (public dizininde medya yok).
# [OR] bu iki kosulu "VEYA" ile baglar: dosya/dizin degilse VE
# (medya yolu VEYA statik uzanti degil) ise index.php'ye git.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.*/)?media/[ps]/ [OR]
RewriteCond %{REQUEST_URI} !.*\.(ico|gif|jpg|jpeg|png|webp|js|css|svg)
RewriteRule ^([^?]*) index.php?route=$1 [L,QSA]
