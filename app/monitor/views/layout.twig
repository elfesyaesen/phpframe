{#
  Monitor dashboard ortak iskeleti — tam ekran uygulama kabuğu.

  Tasarım kısıtları (Response::htmlResponse'un gönderdiği CSP'den gelir):
   - script-src 'self'  -> INLINE <script> ÇALIŞMAZ. Dashboard tamamen
     sunucu-render: filtreler normal GET formu, grafikler CSS çubukları,
     açılır bölümler yerel <details>.
     JS'e ihtiyaç duymamak aynı zamanda dashboard'ın izlenen sistem bozukken
     de açılmasını garanti eder. İstisna: saat ve canlı izleme ayrı bir
     dosyada (/assets/monitor/monitor.js, 'self' olduğu için izinli);
     yüklenmezse sayfa sunucu-render haliyle çalışır.
   - style-src 'self' 'unsafe-inline' -> inline <style> ve style="" serbest
     (çubuk yükseklikleri/genişlikleri buradan verilir).
   - font-src 'self' -> harici font yok; sistem font yığını kullanılır.
#}
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="color-scheme" content="dark light">
  <title>{% block title %}Monitor{% endblock %}</title>
  <script src="/assets/monitor/monitor.js" defer></script>
  <style>
    :root {
      --bg: #0b0e14; --bg-2: #10141c; --panel: #141923; --panel-2: #1a2030;
      --border: #232a38; --border-2: #2e3647;
      --text: #e7ecf3; --muted: #8a94a6; --faint: #5d6678;
      --accent: #7c8cff; --accent-soft: rgba(124, 140, 255, .14);
      --green: #34d399; --green-soft: rgba(52, 211, 153, .14);
      --blue: #60a5fa;  --blue-soft: rgba(96, 165, 250, .14);
      --amber: #fbbf24; --amber-soft: rgba(251, 191, 36, .14);
      --red: #f87171;   --red-soft: rgba(248, 113, 113, .14);
      --violet: #c084fc; --violet-soft: rgba(192, 132, 252, .14);
      --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 8px 24px rgba(0, 0, 0, .18);
      --radius: 12px;
      --sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      --mono: ui-monospace, SFMono-Regular, "Cascadia Code", Menlo, Consolas, monospace;
    }
    @media (prefers-color-scheme: light) {
      :root {
        --bg: #f4f6fa; --bg-2: #eef1f6; --panel: #ffffff; --panel-2: #f7f9fc;
        --border: #e3e8f0; --border-2: #d3dae6;
        --text: #141a26; --muted: #5b6577; --faint: #8a93a3;
        --accent: #4f5bd5; --accent-soft: rgba(79, 91, 213, .1);
        --green: #059669; --green-soft: rgba(5, 150, 105, .1);
        --blue: #2563eb;  --blue-soft: rgba(37, 99, 235, .1);
        --amber: #b45309; --amber-soft: rgba(217, 119, 6, .12);
        --red: #dc2626;   --red-soft: rgba(220, 38, 38, .1);
        --violet: #7c3aed; --violet-soft: rgba(124, 58, 237, .1);
        --shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 6px 20px rgba(16, 24, 40, .06);
      }
    }

    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0; background: var(--bg); color: var(--text);
      font: 14px/1.55 var(--sans); -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { text-decoration: underline; }
    .mono { font-family: var(--mono); font-size: 12.5px; }
    .muted { color: var(--muted); }
    .faint { color: var(--faint); }
    .num { font-variant-numeric: tabular-nums; }

    /* ── Kabuk ─────────────────────────────────────────────── */
    .app { display: grid; grid-template-columns: 248px minmax(0, 1fr); min-height: 100vh; }
    .side {
      position: sticky; top: 0; height: 100vh; overflow-y: auto;
      background: var(--bg-2); border-right: 1px solid var(--border);
      padding: 20px 14px; display: flex; flex-direction: column; gap: 22px;
    }
    .brand { display: flex; align-items: center; gap: 10px; padding: 0 8px; color: var(--text); }
    .brand:hover { text-decoration: none; }
    .brand-mark {
      width: 32px; height: 32px; border-radius: 9px; display: grid; place-items: center;
      background: linear-gradient(135deg, var(--accent), var(--violet)); color: #fff;
    }
    .brand-name { font-weight: 650; font-size: 15px; letter-spacing: -.01em; }
    .brand-sub { font-size: 11.5px; color: var(--muted); }
    .nav-title {
      font-size: 11px; font-weight: 600; color: var(--faint); text-transform: uppercase;
      letter-spacing: .06em; padding: 0 10px; margin-bottom: 6px;
    }
    .nav a {
      display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 8px;
      color: var(--muted); font-weight: 500;
    }
    .nav a:hover { background: var(--panel); color: var(--text); text-decoration: none; }
    .nav a.on { background: var(--accent-soft); color: var(--text); }
    .nav .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
    .nav .ico { flex: none; opacity: .85; }
    .nav .sub { margin: 2px 0 4px 18px; padding-left: 10px; border-left: 1px solid var(--border); }
    .nav .sub a { padding: 5px 10px; font-size: 13px; }
    .side-foot { margin-top: auto; padding: 0 10px; font-size: 12px; color: var(--muted); }
    .side-foot dl { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; margin: 0; }
    .side-foot dd { margin: 0; color: var(--text); text-align: right; }

    .main { min-width: 0; display: flex; flex-direction: column; }
    .topbar {
      position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 16px;
      flex-wrap: wrap; padding: 14px 28px; border-bottom: 1px solid var(--border);
      background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: blur(10px);
    }
    .topbar h1 { font-size: 17px; font-weight: 650; margin: 0; letter-spacing: -.01em; }
    .topbar .spacer { flex: 1; }
    .content { padding: 24px 28px 40px; display: flex; flex-direction: column; gap: 20px; }

    /* ── Bileşenler ────────────────────────────────────────── */
    .panel {
      background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius);
      box-shadow: var(--shadow); min-width: 0;
    }
    .panel-head {
      display: flex; align-items: center; gap: 10px; padding: 14px 18px;
      border-bottom: 1px solid var(--border);
    }
    .panel-head h2 { font-size: 13.5px; font-weight: 600; margin: 0; }
    .panel-head .spacer { flex: 1; }
    .panel-body { padding: 16px 18px; }

    .pill {
      display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px;
      font-size: 12px; font-weight: 600; background: var(--panel-2); border: 1px solid var(--border);
      color: var(--muted); white-space: nowrap;
    }
    .pill .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .pill-prod { color: var(--red); background: var(--red-soft); border-color: transparent; }
    .pill-dev  { color: var(--amber); background: var(--amber-soft); border-color: transparent; }
    .pill-live { color: var(--green); background: var(--green-soft); border-color: transparent; }
    .pill-live .dot { animation: pulse 1.6s ease-in-out infinite; }
    @keyframes pulse { 50% { opacity: .25; } }
    /* Canlı izlemede yeni gelen satırlar */
    .is-new > td, .is-new { animation: flash 2.4s ease-out; }
    @keyframes flash { from { background: var(--accent-soft); } }

    .seg { display: inline-flex; background: var(--panel); border: 1px solid var(--border); border-radius: 9px; padding: 3px; }
    .seg a { padding: 4px 11px; border-radius: 6px; color: var(--muted); font-size: 12.5px; font-weight: 600; }
    .seg a:hover { color: var(--text); text-decoration: none; }
    .seg a.on { background: var(--accent-soft); color: var(--text); }

    .btn {
      display: inline-flex; align-items: center; gap: 6px; height: 34px; padding: 0 14px;
      border-radius: 8px; border: 1px solid var(--border-2); background: var(--panel-2);
      color: var(--text); font: 600 13px var(--sans); cursor: pointer; white-space: nowrap;
    }
    .btn:hover { border-color: var(--accent); text-decoration: none; }
    .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn-primary:hover { filter: brightness(1.08); }
    .btn-ghost { background: transparent; border-color: transparent; color: var(--muted); }

    .badge {
      display: inline-block; min-width: 54px; text-align: center; padding: 2px 8px; border-radius: 6px;
      font: 700 11px var(--mono); letter-spacing: .02em;
    }
    .m-get    { color: var(--green);  background: var(--green-soft); }
    .m-post   { color: var(--blue);   background: var(--blue-soft); }
    .m-put,
    .m-patch  { color: var(--amber);  background: var(--amber-soft); }
    .m-delete { color: var(--red);    background: var(--red-soft); }
    .m-other  { color: var(--violet); background: var(--violet-soft); }

    .status { display: inline-flex; align-items: center; gap: 6px; font: 600 12.5px var(--mono); }
    .status::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
    .s-2 { color: var(--green); }
    .s-3 { color: var(--blue); }
    .s-4 { color: var(--amber); }
    .s-5 { color: var(--red); }

    .d-fast { color: var(--green); }
    .d-mid  { color: var(--amber); }
    .d-slow { color: var(--red); }
    .flag {
      display: inline-block; padding: 1px 7px; border-radius: 6px; font-size: 11px; font-weight: 700;
      color: var(--red); background: var(--red-soft);
    }

    pre {
      margin: 0; padding: 14px 16px; overflow-x: auto; border-radius: 10px;
      background: var(--bg-2); border: 1px solid var(--border);
      font: 12.5px/1.6 var(--mono); white-space: pre-wrap; word-break: break-word;
    }
    .empty { padding: 48px 20px; text-align: center; color: var(--muted); }
    .empty strong { display: block; color: var(--text); font-size: 15px; margin-bottom: 4px; }

    @media (max-width: 960px) {
      .app { grid-template-columns: minmax(0, 1fr); }
      .side {
        position: static; height: auto; flex-direction: row; flex-wrap: wrap; align-items: center;
        gap: 12px; padding: 12px 16px; border-right: 0; border-bottom: 1px solid var(--border);
      }
      .side .nav-group, .side-foot { display: none; }
      .topbar { position: static; padding: 12px 16px; }
      .content { padding: 16px; }
    }
  </style>
  {% block head %}{% endblock %}
</head>
<body{% if filters is defined and filters.live %} data-live="/monitor/live"{% endif %}>
  <div class="app">
    <aside class="side">
      <a class="brand" href="/monitor">
        <span class="brand-mark" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 12 7 12 10 4 14 20 17 12 21 12"/></svg>
        </span>
        <span>
          <span class="brand-name">Monitor</span><br>
          <span class="brand-sub">PHPFrame İstek İzleme</span>
        </span>
      </a>

      <nav class="nav nav-group">
        <div class="nav-title">Gezinme</div>
        {% set view = view|default('') %}
        {% set hq = filters is defined ? 'hours=' ~ filters.hours ~ '&' : '' %}
        <a href="/monitor{{ filters is defined ? '?hours=' ~ filters.hours : '' }}" class="{{ view == 'report' ? 'on' : '' }}">
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/></svg>Genel bakış
        </a>
        <a href="/monitor/requests{{ filters is defined ? '?hours=' ~ filters.hours : '' }}" class="{{ view == 'all' or view == 'detail' ? 'on' : '' }}">
          <svg class="ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>Tüm istekler
        </a>
        <div class="sub">
          <a href="/monitor/requests?{{ hq }}status_class=5" class="{{ view == 'errors' ? 'on' : '' }}"><span class="dot" style="background:var(--red)"></span>Sunucu hataları</a>
          <a href="/monitor/requests?{{ hq }}status_class=4" class="{{ view == 'client' ? 'on' : '' }}"><span class="dot" style="background:var(--amber)"></span>İstemci hataları</a>
          <a href="/monitor/requests?{{ hq }}min_duration={{ slowMs }}" class="{{ view == 'slow' ? 'on' : '' }}"><span class="dot" style="background:var(--violet)"></span>Yavaş istekler</a>
          <a href="/monitor/requests?{{ hq }}n_plus_one=1" class="{{ view == 'nplus' ? 'on' : '' }}"><span class="dot" style="background:var(--blue)"></span>N+1 şüphesi</a>
        </div>
      </nav>

      <div class="side-foot">
        <div class="nav-title" style="padding:0;margin-bottom:8px">Yapılandırma</div>
        <dl>
          <dt>Ortam</dt><dd>{{ production ? 'production' : 'dev' }}</dd>
          <dt>Yavaş istek</dt><dd class="num">≥ {{ slowMs }} ms</dd>
          <dt>Yavaş sorgu</dt><dd class="num">≥ {{ slowQueryMs }} ms</dd>
        </dl>
        <p class="faint" style="margin:12px 0 0;font-size:11.5px">
          Tüm istekler kaydedilir; yalnızca /monitor ve bot taramaları atlanır.
        </p>
      </div>
    </aside>

    <div class="main">
      <header class="topbar">
        <div class="topbar-dynamic">{% block topbar %}<h1>Monitor</h1>{% endblock %}</div>
        <span class="spacer"></span>
        <span class="pill {{ production ? 'pill-prod' : 'pill-dev' }}"><span class="dot"></span>{{ production ? 'production' : 'dev' }}</span>
        <span class="pill faint num" title="Sunucu saati ({{ now|date('e') }})" data-clock data-now="{{ now }}" data-tz="{{ now|date('e') }}">{{ now|date('H:i:s') }}</span>
      </header>
      <main class="content">
        {% block content %}{% endblock %}
      </main>
    </div>
  </div>
</body>
</html>
