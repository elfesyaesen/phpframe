# PHPFrame ortam değişkenleri örneği.
# Gerçek değerlerle kopyalayın:  cp .env.example .env
# Bu dosya git'te tutulur; .env asla commit edilmez.

# ───────────── Uygulama ─────────────
# Üretim modu. true → derlenmiş cache'ler (container graph + route cache) aktif,
# hata ayrıntıları gizli. Geliştirmede false yapın (debug açık, cache devre dışı).
APP_PRODUCTION=false
APP_URL=https://example.app/
APP_TIMEZONE=Europe/Istanbul

# ───────────── Veritabanı (MySQL) ─────────────
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_PREFIX=tr_
DB_TIMEOUT=30
# MySQL TLS (uzak/managed DB için). DB_SSL=true iken DB_SSL_CA zorunlu; istemci
# sertifikası (mutual TLS) için DB_SSL_CERT + DB_SSL_KEY; DB_SSL_VERIFY sunucu
# sertifikasını doğrular. Yerel/aynı-makine DB'de gerekmez → boş bırakın.
DB_SSL=false
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_VERIFY=true
# Kalıcı (persistent) PDO bağlantısı: FPM worker ömrü boyunca bağlantı yeniden
# kullanılır, request başına TCP/TLS el sıkışması maliyetini eler (100K+ RPS için
# önemli). Üretimde önerilen yol bir bağlantı havuzudur (PgBouncer, transaction
# pooling); PgBouncer kullanıyorsanız bunu false bırakın. İkisini aynı anda
# açmayın. Geliştirmede false tutmak en güvenlisidir.
DB_PERSISTENT=false

# ───────────── Cache / Redis (Faz 4) ─────────────
# CACHE_DRIVER: redis | null
CACHE_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Kalıcı (persistent) Redis bağlantısı: FPM worker ömrü boyunca bağlantı yeniden
# kullanılır (pconnect), request başına bağlantı maliyetini eler. Üretimde önerilir.
REDIS_PERSISTENT=false
CACHE_PREFIX=phpframe
# Saniye cinsinden varsayılan TTL
CACHE_DEFAULT_TTL=300

# ───────────── SMTP / Mail ─────────────
SMTP_PROTOCOL=tls
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TITLE=PHPFrame
# TLS sertifikası doğrulanacak mı? ÜRETİMDE `true` BIRAKIN.
# `false` yaparsanız araya girebilen biri kendi sertifikasıyla oturup parola
# sıfırlama bağlantılarını ve SMTP_PASSWORD'ü okuyabilir. Yalnızca
# self-signed sertifikalı yerel bir mail sunucusu için kapatın.
SMTP_VERIFY_TLS=true

# ───────────── Parola sıfırlama ─────────────
# Mail HEM tek kullanımlık bir BAĞLANTI hem 6 haneli bir KOD taşır; ikisi de
# aynı kaydın anahtarıdır ve biri kullanıldığında diğeri de ölür.
#   • Bağlantı → POST /v1/api/users/reset-password/confirm     {token, password}
#   • Kod      → POST /v1/api/users/reset-password/verify-code {email, code, password}
# Mobil-only kurulumda kod her koşulda çalışır; bağlantı aşağıdaki ayara bağlı.

# Sıfırlama kaydının ömrü — SANİYE. Access token'dan (1 saat) kısa tutulur:
# bağlantı ve kod, e-posta kutusunda bekleyen, tek kullanımlık, tam hesap
# devralma yetkisi taşıyan sırlardır.
PASSWORD_RESET_EXPIRE=1800

# Bağlantının işaret ettiği ÖN YÜZ hedefi — API ucu DEĞİL. İki biçim geçerli:
#   GÖRELİ yol → APP_URL ile birleştirilir            (reset-password)
#   MUTLAK URL → aynen kullanılır, APP_URL eklenmez   (https://app.example.com/reset)
# Universal/App Link ya da custom scheme (myapp://reset) için MUTLAK yazın.
# Hedef `?token=` parametresini alıp .../reset-password/confirm ucunu çağırır.
PASSWORD_RESET_URL=reset-password

# OTP kodu için hatalı deneme bütçesi. Kod 6 hane (10^6), yani kaba kuvvete
# açık; rota bazlı rate limit IP döndürerek aşılır. Bu yüzden sayaç kaydın
# KENDİSİNDE tutulur; her deneme karşılaştırmadan önce sayılır. Bu sayıya
# ulaşan kayıt artık eşleşmez (bağlantı da ölür) ve süresi dolana kadar yeni
# talebi de engeller — saldırgan kaç IP kullanırsa kullansın hesap başına
# bütçesi biter.
PASSWORD_RESET_MAX_ATTEMPTS=5

# ───────────── Güvenlik ─────────────
# 64+ karakterlik rastgele JWT imzalama anahtarı üretin:
#   php -r "echo bin2hex(random_bytes(32));"
SECRET_KEY=
# Production'da `*` OLAMAZ. Her girdi şema + host (+ port): https://app.example.com
# Şemasız (app.example.com) ya da yollu (https://x.com/app) girdi boot'u durdurur.
CORS_ORIGINS=*
# Yalnızca IP veya CIDR (IPv4/IPv6): 10.0.0.0/8, fd00::/8. Ana bilgisayar adı
# (localhost) geçersizdir ve production boot'unu durdurur.
TRUSTED_PROXIES=127.0.0.1,::1
# Access token KISA ömürlü olmalı (her istekte yalnızca imza doğrulanır, DB'ye
# bakılmaz). Uzun access ömrü, refresh-token rotation'ın iptal/güvenlik değerini
# yok eder. Önerilen: 900 (15 dk). Refresh uzun olabilir (örn. 7 gün = 604800).
ACCESS_TOKEN_EXPIRE=900
REFRESH_TOKEN_EXPIRE=604800

# ───────────── Loglama ─────────────
# LOG_ROTATION_PERIOD: daily | weekly | monthly
LOG_ROTATION_PERIOD=daily
LOG_RETENTION=15
LOG_MAX_FILE_SIZE_MB=10

# ───────────── Monitor (gözlemlenebilirlik) ─────────────
# Kapalıyken monitor hiçbir shutdown fonksiyonu kaydetmez ve çıktı tamponu
# açmaz — maliyeti tam olarak sıfırdır. Açmadan önce `php frame migrate`.
MONITOR_ENABLED=false

# Dashboard'ın TEK erişim yolu bu paylaşılan sırdır. MONITOR_ENABLED=true iken
# production'da en az 32 karakter ZORUNLU (boot doğrulaması); boşsa dashboard
# her istekte 404 döner.
# Klavye dizisi ("qwerty...") KULLANMAYIN; üretmek için:
#   php -r "echo bin2hex(random_bytes(32));"
# Kullanım: araçlar X-Monitor-Token header'ı gönderir. Tarayıcıda bir kez
# ?token=... ile girilir; token /monitor kapsamlı HttpOnly cookie'ye alınır ve
# URL'den düşürülür, sonraki gezinme cookie ile yürür (sır adres çubuğunda,
# geçmişte ve Referer'da birikmez).
MONITOR_TOKEN=

# SQL sorgularını kaydet. DB_PERSISTENT=true iken PDO ATTR_STATEMENT_CLASS'ı
# desteklemediği için otomatik devre dışı kalır (bağlantı asla riske atılmaz).
MONITOR_RECORD_QUERIES=true
# Cache hit/miss sayaçlarını kaydet.
MONITOR_RECORD_CACHE=true

# Bu süreyi (ms) aşan istek her zaman saklanır.
MONITOR_SLOW_MS=1000
# Bu süreyi (ms) aşan sorgu dashboard'da yavaş olarak işaretlenir.
MONITOR_SLOW_QUERY_MS=100

# Gövde yakalama. Yanıt gövdesi yakalamak ob_start() gerektirir; büyük dosya
# indirmelerinde yanıt bellekte iki kez durur, bu yüzden production'da kapalıdır.
MONITOR_CAPTURE_REQUEST_BODY=false
MONITOR_CAPTURE_RESPONSE_BODY=false
MONITOR_MAX_BODY_BYTES=65535

# İstek başına saklanacak sorgu DETAYI sayısı. Sayaçlar (query_count,
# query_time_ms) bu sınırdan bağımsız olarak tüm sorguları sayar.
MONITOR_MAX_QUERIES=100
# Aynı normalize SQL bu kadar tekrarlanırsa istek N+1 olarak işaretlenir.
MONITOR_N_PLUS_ONE_THRESHOLD=5

# Saklama süresi (gün). Monitor istek/yanıt gövdesi sakladığı için bu aynı
# zamanda bir KİŞİSEL VERİ saklama süresidir — kısa tutun ve purge'ü cron'a bağlayın:
#   0 4 * * * cd /path/to/app && php frame monitor:purge
MONITOR_RETENTION_DAYS=7

# Bu prefix'lerle başlayan yollar hiç kaydedilmez (virgülle ayrılmış).
# `/monitor` listede KALMALI: aksi halde dashboard'ın her sayfa görüntülemesi
# yeni bir kayıt üretir ve izleme kendi gürültüsünü izlemeye başlar.
MONITOR_SKIP_PREFIXES=/monitor

# ───────────── Medya (yükleme ve yayın) ─────────────
# Koleksiyon kuralları (tür, boyut, varyantlar, public/private, gereken izin)
# config/media.php içindedir. Ayrıntı ve web sunucusu ayarları: docs/media-server.md
#
# Özel (private) dosya adreslerini imzalayan anahtar. SECRET_KEY'den AYRI
# olmalı; production'da en az 32 karakter zorunlu (boot durur). Üretmek için:
#   php -r "echo bin2hex(random_bytes(32));"
MEDIA_SIGNING_KEY=
# Anahtar değiştirirken eski anahtarı buraya yazın: açık sayfalardaki adresler
# en fazla 2×MEDIA_SIGNED_TTL içinde yenilenir, sonra bu satırı boşaltın.
MEDIA_SIGNING_KEY_PREVIOUS=
# İmzalı adreslerin ömrü (sn). Adresler bu büyüklükte dilimlere yuvarlanır;
# kalan ömür TTL ile 2×TTL arasındadır.
MEDIA_SIGNED_TTL=600

# Public görsellerin adres tabanı. Boşsa APP_URL/media. CDN'e geçişte yalnızca
# bu değişir (CDN'in origin'i APP_URL/media olarak ayarlanır):
#   MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/media
MEDIA_PUBLIC_BASE_URL=

# Dosyayı kim gönderir: none (PHP akıtır) | apache (mod_xsendfile) | nginx (X-Accel-Redirect)
MEDIA_SENDFILE=none
# MEDIA_SENDFILE=nginx iken internal location öneki
MEDIA_NGINX_INTERNAL_PREFIX=/_protected_media

# Resim sürücüsü: auto (Imagick varsa o, yoksa GD) | gd | imagick
# Sürücü yoksa resim yüklemeleri 503 ile reddedilir (yeniden kodlanmayan resim kabul edilmez).
MEDIA_IMAGE_DRIVER=auto
# Çözmeden önce uygulanan piksel sınırı (decompression bomb koruması)
MEDIA_MAX_PIXELS=40000000
# `full` varyantının en uzun kenarı (px); yüklenen resim bundan büyükse küçültülür
MEDIA_MAX_DIMENSION=2560
# WebP/AVIF kalitesi (40-100)
MEDIA_QUALITY=82
# WebP'ye ek olarak AVIF üret (sürücü destekliyorsa)
MEDIA_AVIF=false

# Kullanıcı başına toplam depolama (MB). 0 = sınırsız
MEDIA_USER_QUOTA_MB=500
# Cross-Origin-Resource-Policy: cross-origin (Angular admin başka alan adındaysa) | same-site | same-origin
MEDIA_CORP=cross-origin
